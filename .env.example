DATABASE_URL=postgres://truthgap:truthgap@localhost:5434/truthgap

# LLM providers — Anthropic for the agents, OpenAI for embeddings
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Models
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_EXTRACTION_MODEL=claude-haiku-4-5-20251001
OPENAI_EMBED_MODEL=text-embedding-3-small

# Working dir for cloned repos
TRUTHGAP_WORKDIR=/tmp/truthgap-repos
