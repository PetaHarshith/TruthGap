DATABASE_URL=postgres://truthgap:truthgap@localhost:5434/truthgap

# Anthropic powers all agents + extraction + consolidator + patcher.
# Embeddings run LOCALLY via @huggingface/transformers (all-MiniLM-L6-v2, 384-d),
# so no embedding API key is required.
ANTHROPIC_API_KEY=

# Models
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_EXTRACTION_MODEL=claude-haiku-4-5-20251001

# Working dir for cloned repos
TRUTHGAP_WORKDIR=/tmp/truthgap-repos
